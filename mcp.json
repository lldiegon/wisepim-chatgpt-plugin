{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "wisepim": {
      "type": "streamable-http",
      "url": "https://wisepim.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "wisepim-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://wisepim.com/mcp",
            "baseScopes": [
              "catalog:read",
              "quality:read",
              "tasks:read",
              "settings:read",
              "enrichment:execute"
            ]
          }
        }
      }
    }
  }
}
